{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/cadet-modules", "destination": "/cadet-modules.html" },
    { "source": "/cadet-dashboard", "destination": "/cadet-dashboard.html" },
    { "source": "/cadet-profile", "destination": "/cadet-profile.html" },
    { "source": "/admin-qr-scanner", "destination": "/admin-qr-scanner.html" },
    { "source": "/admin-attendance", "destination": "/admin-attendance.html" },
    { "source": "/admin-cadets", "destination": "/admin-cadets.html" },
    { "source": "/admin-dashboard", "destination": "/admin-dashboard.html" },
    { "source": "/admin-applications", "destination": "/admin-applications.html" },
    { "source": "/admin-posting", "destination": "/admin-posting.html" },
    { "source": "/admin-documents", "destination": "/admin-documents.html" },
    { "source": "/admin-reports", "destination": "/admin-reports.html" },
    { "source": "/admin-settings", "destination": "/admin-settings.html" },
    { "source": "/admin-accounts", "destination": "/admin-accounts.html" },
    { "source": "/admin-personnel", "destination": "/admin-personnel.html" },
    { "source": "/events", "destination": "/events.html" },
    { "source": "/gallery", "destination": "/gallery.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ]
}

